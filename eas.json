{
  "cli": {
    "version": ">= 25.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.22.1",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.colcheteapp.com.br/api"
      }
